{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khaam-motion.local/schemas/hyperframes-motion-plan-v1.json",
  "title": "Khaam HyperFrames Motion Plan",
  "description": "A content-grounded scene plan. Template variables are cross-checked against motion-catalog.json by validate_motion_plan.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "aspectRatio", "scenes"],
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "string", "minLength": 1, "maxLength": 100 },
    "aspectRatio": { "type": "string", "enum": ["9:16", "16:9", "1:1"] },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "timing": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["startCue", "endCue"],
          "properties": {
            "startCue": { "type": "string", "minLength": 1, "maxLength": 120 },
            "endCue": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["startSeconds", "endSeconds"],
          "properties": {
            "startSeconds": { "type": "number", "minimum": 0 },
            "endSeconds": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "templateId", "timing", "sourceQuote", "intent", "layoutMode", "requiredInformation", "forbiddenInformation", "variables"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "templateId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "timing": { "$ref": "#/$defs/timing" },
        "sourceQuote": { "type": "string", "minLength": 1, "maxLength": 500 },
        "intent": { "type": "string", "minLength": 1, "maxLength": 240 },
        "layoutMode": { "type": "string", "enum": ["fullscreen", "overlay", "data", "transition"] },
        "requiredInformation": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "forbiddenInformation": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "variables": { "type": "object" },
        "note": { "type": "string", "maxLength": 240 }
      }
    }
  }
}
